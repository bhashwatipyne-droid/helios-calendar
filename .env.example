# Google reCAPTCHA v2 ("I'm not a robot" checkbox).
# Leave both empty to use the built-in placeholder checkbox (for local/dev only).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Supabase Storage (stores only the final calendar PNG). Leave empty to disable storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Also set UPLOAD_SECRET (same value) as an Edge Function secret in Supabase.
UPLOAD_SECRET=
