# Google reCAPTCHA v2 ("I'm not a robot" checkbox).
# Leave both empty to use the built-in placeholder checkbox (for local/dev only).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Cloudflare R2 (stores the final print PNG + PDF; never the user's photo). Leave empty to disable storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=helios-calendars

# Employee URL (/employee) accepts only these corporate email domains (comma-separated)
EMPLOYEE_EMAIL_DOMAINS=heliosmf.in
